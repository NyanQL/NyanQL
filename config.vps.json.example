{
  "name": "NyanQL MCP",
  "profile": "ChatGPT Developer mode向けNyanQL MCP Server",
  "version": "0.0.21",
  "Port": 443,
  "BasicAuth": {
    "Username": "CHANGE_ME",
    "Password": "CHANGE_ME"
  },
  "certPath": "/etc/nyanql/tls/fullchain.pem",
  "keyPath": "/etc/nyanql/tls/privkey.pem",
  "DBType": "sqlite",
  "DBUser": "",
  "DBPassword": "",
  "DBName": "/var/lib/nyanql/stamps.db?_foreign_keys=on&_busy_timeout=5000&_journal_mode=WAL",
  "DBHost": "",
  "DBPort": "",
  "MaxOpenConnections": 5,
  "MaxIdleConnections": 5,
  "ConnMaxLifetimeSeconds": 3600,
  "log": {
    "Filename": "/var/log/nyanql/nyanql.log",
    "MaxSize": 5,
    "MaxBackups": 3,
    "MaxAge": 7,
    "Compress": true,
    "EnableLogging": true
  },
  "javascript_include": [
    "/opt/nyanql/src/javascript/lib/nyanRequestCheck.js",
    "/opt/nyanql/src/javascript/base.js"
  ],
  "APIHotReload": {
    "Enabled": true,
    "Interval": "1s"
  }
}
