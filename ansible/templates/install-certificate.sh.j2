#!/bin/sh
set -eu

expected_lineage="{{ letsencrypt_live_dir }}"
lineage="${1:-${RENEWED_LINEAGE:-${expected_lineage}}}"

if [ "${lineage}" != "${expected_lineage}" ]; then
    echo "changed=0"
    exit 0
fi

source_chain="${lineage}/fullchain.pem"
source_key="${lineage}/privkey.pem"
destination_chain="{{ nyanql_tls_dir }}/fullchain.pem"
destination_key="{{ nyanql_tls_dir }}/privkey.pem"
changed=0

test -s "${source_chain}"
test -s "${source_key}"

if ! cmp -s "${source_chain}" "${destination_chain}" 2>/dev/null; then
    install -o root -g {{ nyanql_service_group }} -m 0640 "${source_chain}" "${destination_chain}.new"
    mv -f "${destination_chain}.new" "${destination_chain}"
    changed=1
fi

if ! cmp -s "${source_key}" "${destination_key}" 2>/dev/null; then
    install -o root -g {{ nyanql_service_group }} -m 0640 "${source_key}" "${destination_key}.new"
    mv -f "${destination_key}.new" "${destination_key}"
    changed=1
fi

if [ "${changed}" -eq 1 ] && systemctl cat nyanql.service >/dev/null 2>&1; then
    systemctl try-restart nyanql.service
fi

echo "changed=${changed}"
